{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.12.0/schema.json",
  "name": "line_chart",
  "position": {
    "x": 720,
    "y": 355,
    "z": 8000,
    "height": 255,
    "width": 700,
    "tabOrder": 8000
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimPOLine"
                    }
                  },
                  "Property": "LINE_NBR"
                }
              },
              "queryRef": "DimPOLine.LINE_NBR",
              "nativeQueryRef": "LINE_NBR",
              "active": true,
              "displayName": "LINE_NBR"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "BudgetMeasures"
                    }
                  },
                  "Property": "Encumbrance Amount"
                }
              },
              "queryRef": "BudgetMeasures.Encumbrance Amount",
              "nativeQueryRef": "Encumbrance Amount",
              "displayName": "Encumbrance Amount"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "BudgetMeasures"
                    }
                  },
                  "Property": "Expense Amount"
                }
              },
              "queryRef": "BudgetMeasures.Expense Amount",
              "nativeQueryRef": "Expense Amount",
              "displayName": "Expense Amount"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Encumbrance vs Expense by PO Line'"
                }
              }
            },
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ]
    }
  }
}